import org.apache.spark.sql.functions._

// Chargement du fichier de ventes
val df = spark.read
  .option("header", "true")
  .option("inferSchema", "true")
  .csv("dbfs:/FileStore/raw_layer/w003/sales/")

// Liste des produits prioritaires
val priorityProducts = List("P001", "P002", "P003", "P004", "P005", "P006", "P007", "P008", "P009", "P010")

// Filtrage des produits prioritaires
val filteredDf = df.filter(col("product_id").isin(priorityProducts: _*)).cache()

// 1. Total des ventes par catégorie
val totalByCategory = filteredDf
  .groupBy("category")
  .agg(sum("amount").alias("total_sales"))

// 2. Top 5 clients par ventes
val topClients = filteredDf
  .groupBy("client_id")
  .agg(sum("amount").alias("total_client_sales"))
  .orderBy(desc("total_client_sales"))
  .limit(5)

// Affichage des résultats
display(totalByCategory)
display(topClients)
