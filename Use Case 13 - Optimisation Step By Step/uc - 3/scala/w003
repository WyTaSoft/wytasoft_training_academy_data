import org.apache.spark.sql.SparkSession
import org.apache.spark.sql.functions._

object NonOptimizedProductAnalysis {
  def main(args: Array[String]): Unit = {
    val spark = SparkSession.builder()
      .appName("ProductAnalysis")
      .getOrCreate()

    import spark.implicits._

    val df = spark.read
      .option("header", "true")
      .option("inferSchema", "true")
      .csv("sales.csv")

    // Liste des produits prioritaires (hardcodée, non broadcastée)
    val priorityProducts = List("P001", "P002", "P003", "P004", "P005", "P006", "P007", "P008", "P009", "P010")

    // Filtrage (chaque réutilisation de cette ligne relance tout)
    val filteredDf = df.filter($"product_id".isin(priorityProducts: _*))

    // Première utilisation : total par catégorie
    val totalByCategory = filteredDf
      .groupBy("category")
      .agg(sum("amount").as("total_sales"))

    // Deuxième utilisation : top 5 clients
    val topClients = filteredDf
      .groupBy("client_id")
      .agg(sum("amount").as("total_client_sales"))
      .orderBy(desc("total_client_sales"))
      .limit(5)

    totalByCategory.show()
    topClients.show()
  }
}
