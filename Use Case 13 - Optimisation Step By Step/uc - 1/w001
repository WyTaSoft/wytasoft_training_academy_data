import org.apache.spark.sql.SparkSession
import org.apache.spark.sql.functions._

object NonOptimizedJob {
  def main(args: Array[String]): Unit = {

    val df = spark.read
      .format("csv")
      .option("header", "true")
      .load("transactions.csv")

    val filteredDf = df.filter(col("amount") =!= "")
    val castedDf = filteredDf
      .withColumn("amount", col("amount").cast("double"))

    val groupedDf = castedDf
      .groupBy("client_id", "transaction_type")
      .agg(sum("amount").as("total_amount"))

    groupedDf.write
      .format("parquet")
      .save("output/transactions_by_client")
  }
}
