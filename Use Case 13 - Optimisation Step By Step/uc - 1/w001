import org.apache.spark.sql.functions._

// Lecture du fichier CSV depuis DBFS
val df = spark.read
  .format("csv")
  .option("header", "true")
  .load("dbfs:/FileStore/raw_layer/transactions/")

// Filtrage des lignes où "montant" n'est pas vide
val filteredDf = df.filter(col("montant") =!= "")

// Cast de la colonne "montant" en Double
val castedDf = filteredDf.withColumn("montant", col("montant").cast("double"))

// Agrégation par client_id et transaction_type
val groupedDf = castedDf
  .groupBy("client_id", "transaction_type")
  .agg(sum("montant").as("total_amount"))

// Écriture en Parquet
groupedDf.write
  .format("parquet")
  .mode("overwrite")
  .save("dbfs:/FileStore/bronze_layer/transactions_by_client")
