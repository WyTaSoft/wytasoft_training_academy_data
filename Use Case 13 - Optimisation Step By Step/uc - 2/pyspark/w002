from pyspark.sql.functions import *
from pyspark.sql import SparkSession

# Lecture du fichier CSV avec inférence de schéma
df = spark.read \
    .option("header", "true") \
    .option("inferSchema", "true") \
    .csv("dbfs:/FileStore/raw_layer/w002/transactions/") \
    .withColumn("timestamp", col("timestamp").cast("timestamp"))

# -----------------------
# RÈGLE 1 : retraits sur 7 jours > 10 000 €
# -----------------------
retrait_df = df.filter(col("transaction_type") == "retrait")
retrait_with_window = retrait_df.withColumn("window_7d", window(col("timestamp"), "7 days"))
rule1 = retrait_with_window.groupBy("client_id", "window_7d") \
    .agg(sum("amount").alias("total_retrait")) \
    .filter(col("total_retrait") > 10000)

rule1.show()

# -----------------------
# RÈGLE 2 : > 5 transactions à l’étranger en 3 jours
# -----------------------
foreign_df = df.filter(col("country") != "FR")
foreign_with_window = foreign_df.withColumn("window_3d", window(col("timestamp"), "3 days"))
rule2 = foreign_with_window.groupBy("client_id", "window_3d") \
    .agg(count("*").alias("nb_tx")) \
    .filter(col("nb_tx") > 5)

# -----------------------
# RÈGLE 3 : déplacement > 1000 km en < 2h
# -----------------------

def haversine(lat1, lon1, lat2, lon2):
    R = 6371.0
    dLat = radians(lat2 - lat1)
    dLon = radians(lon2 - lon1)
    a = sin(dLat / 2) ** 2 + cos(radians(lat1)) * cos(radians(lat2)) * sin(dLon / 2) ** 2
    c = 2 * atan2(sqrt(a), sqrt(1 - a))
    return R * c

# Ajout des colonnes renommées
df_with_alias = df.select("client_id", "timestamp", "latitude", "longitude") \
    .withColumnRenamed("timestamp", "ts") \
    .withColumnRenamed("latitude", "lat") \
    .withColumnRenamed("longitude", "lon")

a = df_with_alias.alias("a")
b = df_with_alias.alias("b")

joined = a.join(b, (col("a.client_id") == col("b.client_id")) & (col("a.ts") < col("b.ts"))) \
    .filter(unix_timestamp(col("b.ts")) - unix_timestamp(col("a.ts")) < 7200) \
    .withColumn("distance",
        lit(6371.0) * lit(2) * atan2(
            sqrt(
                pow(sin(radians(col("b.lat") - col("a.lat")) / 2), 2) +
                cos(radians(col("a.lat"))) * cos(radians(col("b.lat"))) *
                pow(sin(radians(col("b.lon") - col("a.lon")) / 2), 2)
            ),
            sqrt(1 - (
                pow(sin(radians(col("b.lat") - col("a.lat")) / 2), 2) +
                cos(radians(col("a.lat"))) * cos(radians(col("b.lat"))) *
                pow(sin(radians(col("b.lon") - col("a.lon")) / 2), 2)
            ))
        )
    ) \
    .filter(col("distance") > 1000)

rule3 = joined.select(col("a.client_id").alias("client_id")).distinct()

# -----------------------
# FUSION DES CLIENTS SUSPECTS
# -----------------------
suspects = rule1.select("client_id") \
    .union(rule2.select("client_id")) \
    .union(rule3.select("client_id")) \
    .distinct()

# -----------------------
# SAUVEGARDE
# -----------------------
suspects.write.mode("overwrite").csv("dbfs:/FileStore/bronze_layer/suspects")
